# Backend API (Next.js rewrites /api/v1/* to this origin)
API_URL=http://127.0.0.1:8000

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# BFF auth cookies (httpOnly; set by /api/auth/* routes)
AUTH_ACCESS_COOKIE=aa_access
AUTH_REFRESH_COOKIE=aa_refresh
AUTH_REMEMBER_COOKIE=aa_remember
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_REFRESH_MAX_AGE_SECONDS=2592000

# Optional: allow organization logo URLs in CSP / next/image
# LOGO_IMAGE_HOSTS=http://127.0.0.1:9000

# Optional: extra hosts for next dev (LAN IP, ngrok). Defaults include 192.168.29.19 and *.ngrok-free.dev
# DEV_ORIGINS=10.0.0.5,my-tunnel.ngrok-free.dev
